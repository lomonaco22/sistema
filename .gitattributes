int temperatura = 20;  

void setup() {
  Serial.begin(115200); 
  pinMode(22, OUTPUT);  
  pinMode(23, OUTPUT);  
}

void loop() {
  if (temperatura < 0 || temperatura > 40) {
    Serial.println("ALERTA");
    digitalWrite(22, HIGH);   
    delay(500);
    digitalWrite(22, LOW);
    delay(500);
  }
  else if (temperatura > 10 && temperatura < 30) {
    Serial.println("Normal");
    digitalWrite(23, HIGH);   
    delay(500);
    digitalWrite(23, LOW);
    delay(500);
  }
  else {
    Serial.println("Fuera de rango (10-30)");
    delay(1000);
  }
}

