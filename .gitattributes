#include <Arduino.h>
#include <OneWire.h>
#include <DallasTemperature.h>

  //PIN-ENTRADA
         //sensor de temperatura:DATA DS18B20
      //conexion:1 gnd, 2pin16+resistencia5K,3gnd  
int ONE_WIRE_BUS = 16;
     //LED amarillo+resistencia1k+gnd: pin5
int LED_AMARILLO = 5;
    //LED amarillo+resistencia1k+gnd: pin2
int LED_ROJO = 2;    

   //librerias de DATA DS18B20
OneWire oneWire(ONE_WIRE_BUS);//comunica el sensor con el pin16
DallasTemperature sensors(&oneWire);//lee los datos del sensor. ej:42.88 °C

   //comunicacion entre arduino y la pc
void setup() {
  Serial.begin(115200);
  sensors.begin();

  pinMode(LED_AMARILLO, OUTPUT);
  pinMode(LED_ROJO, OUTPUT);

  digitalWrite(LED_AMARILLO, LOW);
  digitalWrite(LED_ROJO, LOW);
}

void loop() {
  sensors.requestTemperatures();//solicita lectura del DATA DS18B20
  float temperatura = sensors.getTempCByIndex(0); //almacena datos del del DATA DS18B20 en la variable temperatura

  //imprime datos de la variable
  Serial.print("Temperatura: ");
  Serial.print(temperatura);
  Serial.println(" °C");

  // leds off: wait if
  digitalWrite(LED_AMARILLO, LOW);
  digitalWrite(LED_ROJO, LOW);

 
   //Si la temperatura es menor a 0°C o mayor a 40°C:
   //Mostrar el mensaje "¡Alerta!" en la terminal
   //Encender un LED rojo.

  if (temperatura < 0 || temperatura > 45) {
    Serial.println("¡Alerta!");
    digitalWrite(LED_ROJO, HIGH);
  }
   //Si la temperatura está fuera del rango de 10°C a 30°C, encender un LED amarillo.
  else if (temperatura < 15 || temperatura > 35) {
    digitalWrite(LED_AMARILLO, HIGH);
  }  //condicion secundaria: si la primera condición if fue falsa
  delay(8000);//pausa la ejecucion 5 s
}  